{
  "name": "dsh-plantuml",
  "version": "0.1.0",
  "description": "Render PlantUML code blocks in DeepSeek Harness with a Host command, JAR, or PlantUML server.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.5"
  },
  "files": [
    "index.js",
    "renderer.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.js",
    "check": "node scripts/build-client.js --check && node --check index.js && node --check renderer.js && node --check client.js && node --test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
