{
  "name": "dsh-plantuml",
  "version": "0.1.0",
  "description": "Render PlantUML code blocks in DeepSeek Harness with a Host command, JAR, or PlantUML server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanHonN/dsh-plantuml.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./assets/locale/*.json",
    "./icon": "./assets/icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./config/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.5"
  },
  "files": [
    "src/host",
    "dist/client.js",
    "config/cordis.patch.yml",
    "assets"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.js",
    "check": "node scripts/build-client.js --check && node --check src/host/index.js && node --check src/host/renderer.js && node --check dist/client.js && node --test",
    "pack:local": "npm run build:client && npm pack --pack-destination dist"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0"
  }
}
